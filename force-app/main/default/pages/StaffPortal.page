<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="true" applyBodyTag="false" docType="html-5.0">
    <head>
        <meta charset="utf-8" />
        <title>Sea Time - פורטל מדריכים ועובדים</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <meta name="theme-color" content="#0288d1" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="Sea Time מדריכים" />

        <!-- Boat Icon Favicon & Touch Icons -->
        <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'%3E%3Crect width='192' height='192' rx='42' fill='%230284c7'/%3E%3Ccircle cx='148' cy='42' r='16' fill='%23facc15'/%3E%3Cpath d='M96 36v98' stroke='%23fff' stroke-width='4'/%3E%3Cpolygon points='96 36 116 44 96 52' fill='%23f97316'/%3E%3Cpolygon points='102 45 152 124 102 126' fill='%23ffffff'/%3E%3Cpolygon points='90 56 44 125 90 125' fill='%23bae6fd'/%3E%3Cpolygon points='34 134 158 134 142 158 50 158' fill='%23ffffff'/%3E%3Cpath d='M0 160q48-8 96 2t96-2v32H0z' fill='%2338bdf8'/%3E%3C/svg%3E" />
        <link rel="icon" type="image/png" sizes="192x192" href="{!$Resource.StaffPortalBoatIcon}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{!$Resource.StaffPortalBoatIcon}" />
        <link rel="shortcut icon" type="image/png" href="{!$Resource.StaffPortalBoatIcon}" />

        <apex:includeLightning />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                direction: rtl;
                background-color: #f8f9fa;
            }
            #staffPortalContainer {
                width: 100%;
                min-height: 100vh;
            }
            #loadingOverlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: #ffffff;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                font-size: 18px;
                color: #0288d1;
                font-weight: bold;
                z-index: 9999;
                transition: opacity 0.3s ease;
            }
            .loading-spinner {
                width: 40px;
                height: 40px;
                border: 4px solid #e0e0e0;
                border-top: 4px solid #0288d1;
                border-radius: 50%;
                animation: spin 1s linear infinite;
                margin-bottom: 16px;
            }
            @keyframes spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
        </style>
    </head>
    <body>
        <div id="loadingOverlay">
            <div class="loading-spinner"></div>
            <div>טוען פורטל מדריכים...</div>
        </div>
        <div id="staffPortalContainer"></div>
        <script>
            var prefix = "{!$Site.Prefix}";
            var lightningEndPoint = prefix ? (window.location.origin + prefix) : "";
            
            $Lightning.use("c:StaffPortalAppAura", function() {
                $Lightning.createComponent(
                    "c:staffPortalApp",
                    {},
                    "staffPortalContainer",
                    function(cmp, status, errorMessage) {
                        var overlay = document.getElementById("loadingOverlay");
                        if (overlay) {
                            overlay.style.opacity = "0";
                            setTimeout(function() {
                                if (overlay && overlay.parentNode) {
                                    overlay.parentNode.removeChild(overlay);
                                }
                            }, 300);
                        }
                        if (status === "SUCCESS") {
                            console.log("Staff Portal loaded successfully");
                        } else {
                            console.error("Error creating component:", status, errorMessage);
                        }
                    }
                );
            }, lightningEndPoint);
        </script>
    </body>
</apex:page>

<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="true" applyBodyTag="false" docType="html-5.0">
    <head>
        <meta charset="utf-8" />
        <title>Sea Time - פורטל מדריכים ועובדים</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <apex:includeLightning />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100vh;
                font-family: Arial, sans-serif;
                direction: rtl;
                background-color: #f8f9fa;
            }
            #staffPortalContainer {
                width: 100%;
                min-height: 100vh;
            }
            #loadingOverlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: #ffffff;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                font-size: 18px;
                color: #0288d1;
                font-weight: bold;
                z-index: 9999;
                transition: opacity 0.3s ease;
            }
            .loading-spinner {
                width: 40px;
                height: 40px;
                border: 4px solid #e0e0e0;
                border-top: 4px solid #0288d1;
                border-radius: 50%;
                animation: spin 1s linear infinite;
                margin-bottom: 16px;
            }
            @keyframes spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
        </style>
    </head>
    <body>
        <div id="loadingOverlay">
            <div class="loading-spinner"></div>
            <div>טוען פורטל מדריכים...</div>
        </div>
        <div id="staffPortalContainer"></div>
        <script>
            var prefix = "{!$Site.Prefix}";
            var lightningEndPoint = prefix ? (window.location.origin + prefix) : "";
            
            $Lightning.use("c:StaffPortalAppAura", function() {
                $Lightning.createComponent(
                    "c:staffPortalApp",
                    {},
                    "staffPortalContainer",
                    function(cmp, status, errorMessage) {
                        var overlay = document.getElementById("loadingOverlay");
                        if (overlay) {
                            overlay.style.opacity = "0";
                            setTimeout(function() {
                                if (overlay && overlay.parentNode) {
                                    overlay.parentNode.removeChild(overlay);
                                }
                            }, 300);
                        }
                        if (status === "SUCCESS") {
                            console.log("Staff Portal loaded successfully");
                        } else {
                            console.error("Error creating component:", status, errorMessage);
                        }
                    }
                );
            }, lightningEndPoint);
        </script>
    </body>
</apex:page>

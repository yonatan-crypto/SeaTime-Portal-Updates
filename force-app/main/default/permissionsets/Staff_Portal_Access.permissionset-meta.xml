<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Access to Staff Portal tab, components and employee auth and time tracking fields</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Staff Portal Access</label>
    <tabSettings>
        <tab>StaffPortal</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Time_Entry__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Accountant_Report</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <classAccesses>
        <apexClass>StaffPortalController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>StaffLoginController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>StaffTimeTrackingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <pageAccesses>
        <apexPage>StaffPortal</apexPage>
        <enabled>true</enabled>
    </pageAccesses>

    <!-- Object Permissions for Time_Entry__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
